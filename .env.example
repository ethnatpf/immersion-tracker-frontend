# Generation only: the backend must be running when generating.
OPENAPI_URL=http://localhost:4000/api-json

# Server-only backend origin used by the authenticated API proxy.
API_URL=http://localhost:4000

# Auth0 Regular Web Application (server-only; never use NEXT_PUBLIC_ for secrets).
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
# Auth0 API Identifier; must match the backend's AUTH_AUDIENCE.
AUTH0_AUDIENCE=https://your-api-identifier
# Generate locally with: openssl rand -hex 32
AUTH0_SECRET=replace-with-a-generated-64-character-hex-secret
